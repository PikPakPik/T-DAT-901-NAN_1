      "pluginVersion": "12.2.1",
      "targets": [
        {
          "query": "import \"math\"\n\nprice = from(bucket: \"home\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r.symbol == \"BTCUSDT\" and r._field == \"avg_price\" and r._value > 0.0)\n  |> keep(columns: [\"_time\", \"_value\"])\n  |> sort(columns: [\"_time\"])\n\nlog_price = price\n  |> map(fn: (r) => ({ r with _value: math.log(x: r._value) }))\n\nreturns = log_price\n  |> difference()\n\nreturns\n  |> window(every: 1m)\n  |> stddev()\n  |> map(fn: (r) => ({ r with _time: r._stop }))\n  |> keep(columns: [\"_time\", \"_value\"])\n",
          "refId": "A"
        }
      ],
      "title": "Volatility (BTCUSDT)",
      "type": "timeseries"
    }
