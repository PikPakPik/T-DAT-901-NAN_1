# Binance WebSocket
BINANCE_WEBSOCKET_URL=wss://stream.binance.com:443/stream?streams=
BINANCE_AGGREGATE_TRADE_STEAMS=btcusdt@trade,ethusdt@trade

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
TOPIC_TRADE=trade
KAFKA_PARTITIONS=3
KAFKA_GROUP_ID=tdat901nan1

# Stream processor
WINDOW_SECONDS=60
KAFKA_BATCH_SIZE=100
KAFKA_POLL_TIMEOUT_MS=100
KAFKA_MAX_POLL_RECORDS=1000
AGGR_INTERVAL_SECONDS=1.0
INFLUX_URL=http://localhost:8086
INFLUX_ORG=cryptoviz
INFLUX_BUCKET=home

# Scrapper (TradingEconomics)
SCRAPPER_TOPIC=economic-events
SCRAPPER_CONSUMER_GROUP=scrapper-consumer

# Mock generator (optionnel)
MOCK_EVENTS_PER_SECOND=2500

# InfluxDB bootstrap (docker compose)
INFLUXDB_PORT=8086
DOCKER_INFLUXDB_INIT_MODE=setup
DOCKER_INFLUXDB_INIT_USERNAME=admin
DOCKER_INFLUXDB_INIT_PASSWORD=P@ssw0rd
DOCKER_INFLUXDB_INIT_ORG=cryptoviz
DOCKER_INFLUXDB_INIT_BUCKET=home
DOCKER_INFLUXDBV2_ADMIN_TOKEN=Sup3rStr0ngToken123

# Grafana
GRAFANA_PORT=3000
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GF_USERS_ALLOW_SIGN_UP=false